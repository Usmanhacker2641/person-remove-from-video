import imageio
import matplotlib.pyplot as plt
import numpy as np

def read_frames(video_path, num_frames):
    reader = imageio.get_reader(video_path)
    frames = []
    for i, frame in enumerate(reader):
        if i >= num_frames:
            break
        # Convert to grayscale using luminosity method
        gray = np.dot(frame[...,:3], [0.2989, 0.5870, 0.1140])
        frames.append(gray)
    reader.close()
    return frames

def plot_montage(frames, rows, cols, save_path):
    fig, axes = plt.subplots(rows, cols, figsize=(cols*2, rows*2))
    for i in range(rows * cols):
        ax = axes[i // cols, i % cols]
        if i < len(frames):
            ax.imshow(frames[i], cmap='gray')
        ax.axis('off')
    plt.tight_layout()
    plt.savefig(save_path, bbox_inches='tight', pad_inches=0)
    plt.close(fig)

if __name__ == "__main__":
    video_path = "your_video.mp4"  # Change to your video file path
    num_frames_to_show = 12
    rows, cols = 3, 4

    frames = read_frames(video_path, num_frames_to_show)
    plot_montage(frames, rows, cols, "frames_montage.png")